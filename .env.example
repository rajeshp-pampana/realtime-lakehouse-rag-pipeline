# Copy to `.env` and adjust. Nothing here is a secret in local dev, but the file
# is the single place config lives (see README "Config & secrets").

# --- Paths ---
DATA_DIR=data
DELTA_OHLCV_RAW=data/delta/ohlcv_raw
DELTA_OHLCV_CURATED=data/delta/ohlcv_curated
DELTA_TICKS_RAW=data/delta/ticks_raw
VECTORSTORE_DIR=data/vectorstore
STREAM_CHECKPOINT_DIR=data/checkpoints/ticks_stream

# --- Ingestion ---
INGEST_PERIOD=1mo

# --- Kafka (Milestone 2) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TICKS_TOPIC=market.ticks
TICK_INTERVAL_SECONDS=1

# --- LLM / RAG (Milestone 3) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_TOP_K=4
RAG_COLLECTION=market_context
CONTEXT_DOCS_DIR=docs/context
BRIEFINGS_DIR=data/briefings

# --- API (Milestone 4) ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
