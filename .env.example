# Copy to `.env` and adjust. Nothing here is a secret in local dev, but the file
# is the single place config lives (see README "Config & secrets").

# --- Paths ---
DATA_DIR=data
DELTA_OHLCV_RAW=data/delta/ohlcv_raw
DELTA_OHLCV_CURATED=data/delta/ohlcv_curated
DELTA_TICKS_RAW=data/delta/ticks_raw
VECTORSTORE_DIR=data/vectorstore
STREAM_CHECKPOINT_DIR=data/checkpoints/ticks_stream

# --- Ingestion ---
INGEST_PERIOD=1mo

# --- Kafka (Milestone 2) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TICKS_TOPIC=market.ticks
TICK_INTERVAL_SECONDS=1

# --- LLM / RAG (Milestone 3) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_TOP_K=6
RAG_COLLECTION=market_context
# Split documents into chunks before embedding (one vector per section, or per
# list item for list-shaped sections) instead of one vector per file. Measured
# to raise retrieval precision@1 from 0.528 to 0.917 - see docs/METRICS.md.
RAG_CHUNKING=true
CONTEXT_DOCS_DIR=docs/context
BRIEFINGS_DIR=data/briefings

# --- API (Milestone 4) ---
# API_HOST/API_PORT are what the service *binds*; API_BASE_URL is what the
# Streamlit thin client *dials*. Kept separate so M5 can point the UI at a
# container or k8s service without changing how the API binds.
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=30
# Briefing generation runs a local LLM and can take minutes on modest hardware
# (see docs/METRICS.md), so it gets its own much longer timeout.
API_BRIEFING_TIMEOUT_SECONDS=900

# --- Observability (Milestone 6) ---
# Where short-lived batch tasks and the streaming consumer push their metrics.
# Empty disables pushing entirely, which is the default for a plain local run -
# nothing should need a metrics stack running just to ingest data.
PUSHGATEWAY_URL=
METRICS_ENABLED=true
