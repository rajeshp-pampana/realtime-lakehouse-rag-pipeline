# Spark Structured Streaming consumer image. Fully wired in Milestone 5.
# Needs a JRE for local-mode Spark; base image finalised in Milestone 5.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src
CMD ["python", "-m", "src.streaming.stream_consumer"]
